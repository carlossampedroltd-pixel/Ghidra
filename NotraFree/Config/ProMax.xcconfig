// iPhone 17 Pro Max build: standard single-column layout.
#include "Personal.xcconfig"

PRODUCT_NAME = NotraFreeProMax
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_PREFIX).notrafree.promax
APP_DISPLAY_NAME = Notra Pro Max

// Prefix of the iOS OAuth client created for THIS bundle ID
// (everything before ".apps.googleusercontent.com").
GOOGLE_CLIENT_ID = YOUR_PROMAX_CLIENT_ID
